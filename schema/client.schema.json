{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home service client",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "businessName", "trade", "phone", "phoneDisplay", "email", "city", "state", "serviceAreas", "tagline", "heroSubtext", "yearsInBusiness", "licenseNumber", "hours", "services", "reviews", "faqs", "theme", "formAction"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "businessName": {"$ref": "#/$defs/text"},
    "trade": {"$ref": "#/$defs/text"},
    "phone": {"type": "string", "pattern": "^\\+[1-9][0-9]{1,14}$", "description": "E.164: + followed by 2-15 digits, no spaces or punctuation"},
    "phoneDisplay": {"$ref": "#/$defs/text"},
    "email": {"type": "string", "maxLength": 254, "pattern": "^[A-Za-z0-9.!#$%&\\x27*+/=?^_`{|}~-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"},
    "city": {"$ref": "#/$defs/text"},
    "state": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "serviceAreas": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "tagline": {"$ref": "#/$defs/text"},
    "heroSubtext": {"$ref": "#/$defs/text"},
    "yearsInBusiness": {"type": "integer", "minimum": 0, "maximum": 250},
    "licenseNumber": {"type": "string", "maxLength": 160},
    "hours": {"$ref": "#/$defs/text"},
    "services": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["title", "description", "icon"], "properties": {"title": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/paragraph"}, "icon": {"enum": ["wrench", "home", "leaf", "droplet", "snowflake", "bolt"]}}}},
    "reviews": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["name", "text", "stars"], "properties": {"name": {"$ref": "#/$defs/text"}, "text": {"$ref": "#/$defs/paragraph"}, "stars": {"type": "integer", "minimum": 1, "maximum": 5}}}},
    "faqs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["q", "a"], "properties": {"q": {"$ref": "#/$defs/text"}, "a": {"$ref": "#/$defs/paragraph"}}}},
    "theme": {"type": "object", "additionalProperties": false, "required": ["primary", "accent", "heroImage"], "properties": {"primary": {"$ref": "#/$defs/color"}, "accent": {"$ref": "#/$defs/color"}, "heroImage": {"$ref": "#/$defs/image"}, "heroImageAlt": {"$ref": "#/$defs/text"}, "logoImage": {"$ref": "#/$defs/image"}, "logoAlt": {"$ref": "#/$defs/text"}}},
    "formAction": {"type": "string", "pattern": "^(?:https://formspree\\.io/f/[A-Za-z0-9]+)?$"},
    "siteUrl": {"type": "string", "maxLength": 500},
    "preview": {"type": "boolean", "default": false},
    "reviewsAreSamples": {"type": "boolean"},
    "video": {"type": "object", "additionalProperties": false, "required": ["url", "title"], "properties": {"url": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "HTTPS YouTube watch, Shorts, or youtu.be URL, or a local assets/ MP4 or WebM path; checked by videoSource"}, "title": {"$ref": "#/$defs/text"}, "orientation": {"type": "string", "enum": ["vertical", "horizontal"], "default": "vertical"}, "poster": {"$ref": "#/$defs/image", "description": "Optional local video poster; ignored for YouTube"}}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "\\S"},
    "paragraph": {"type": "string", "minLength": 1, "maxLength": 800, "pattern": "\\S"},
    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "image": {"type": "string", "description": "use an image path inside assets/ ending in .jpg, .jpeg, .png, .webp or .avif, or an empty string", "pattern": "^(?:assets/[A-Za-z0-9_/-]+\\.(?:jpg|jpeg|png|webp|avif))?$"}
  }
}
